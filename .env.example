# ---------- Email via Resend (required) ----------
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Comma-separated recipients.
EMAIL_TO=you@example.com
# Sender. Must be on a domain verified in Resend. The default onboarding@resend.dev
# works without a domain but only delivers to your Resend account's own email.
# EMAIL_FROM=CeX 3070 Notify <onboarding@resend.dev>

# ---------- What to watch (all optional) ----------
# CeX's search is loose: "rtx 3070" already returns every RTX 3070 AND 3080 (and their Tis),
# so you rarely need to change this. Adding words can push results past CeX's 1000-per-request cap.
# SEARCH_QUERY=rtx 3070
# Regex the product name must match. This is what actually picks the cards.
#   3070s and 3080s: \b(3070|3080)\b
# NAME_PATTERN=\b3070\b
# Set to false to ignore all Ti cards (3070 Ti, 3080 Ti, ...).
# INCLUDE_TI=true
# What the emails call the cards, e.g. RTX 3070/3080.
# WATCH_LABEL=RTX 3070
# Only alert at or below this price in pounds, e.g. 300. Empty = no limit.
# MAX_PRICE=
# Emails show each price as "£320 → £272" with this % off. 0 hides the second price.
# DISCOUNT_PERCENT=15
# Also email when stock goes down or a model sells out.
# ALERT_ON_DECREASE=true
# UK-time hour (0-23) for the daily "still running" email, or "off".
# DAILY_EMAIL_HOUR=9
# Alert when online stock goes up.
# WATCH_ONLINE=true
# Alert when a store gets stock.
# WATCH_STORES=true
# Comma list of store names to care about (substring match), e.g. Birmingham,Nottingham. Empty = all.
# STORE_FILTER=

# ---------- Scheduling ----------
# CHECK_INTERVAL_MINUTES=5
# If set, the /check URL requires ?token=<value>.
# CHECK_TOKEN=

# ---------- State storage ----------
# Upstash Redis (recommended on Render so state survives restarts).
# Leave empty to use a local JSON file instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# STATE_FILE=./data/state.json
