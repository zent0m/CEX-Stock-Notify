# ---------- ntfy (required) ----------
# Pick a long, hard-to-guess topic name: anyone who knows it can read your alerts.
NTFY_TOPIC=example
# Optional: self-hosted server, and an access token for protected topics.
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# ---------- What to watch (all optional) ----------
# SEARCH_QUERY=rtx 3070
# Regex the product name must match.
# NAME_PATTERN=\b3070\b
# Set to false to ignore 3070 Ti cards.
# INCLUDE_TI=true
# Only alert at or below this price in pounds, e.g. 300. Empty = no limit.
# MAX_PRICE=
# Alert when online stock goes up.
# WATCH_ONLINE=true
# Alert when a store gets stock.
# WATCH_STORES=true
# Comma list of store names to care about (substring match), e.g. Birmingham,Nottingham. Empty = all.
# STORE_FILTER=

# ---------- Scheduling ----------
# CHECK_INTERVAL_MINUTES=5
# If set, the /check URL requires ?token=<value>.
# CHECK_TOKEN=

# ---------- State storage ----------
# Upstash Redis (recommended on Render so state survives restarts).
# Leave empty to use a local JSON file instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# STATE_FILE=./data/state.json
